# ==============================================================================
# .gitignore — nqo1-doxorrubicina-cardiotoxicidade
# Mantém o repositorio limpo: não versiona lixo de SÓ/IDE, cache, logs e segredos.
# Os dados cientificos (data/raw/*.gz) e resultados (output/*) SÃO versionados.
# ==============================================================================

# --- Sistema operacional ------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- R ------------------------------------------------------------------
.Rproj.user
.Rhistory
.RData
.Ruserdata
.Renviron
*.Rproj
renv/library/
renv/local/
renv/staging/
renv/sandbox/
*.Rout

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.conda/
.mypy_cache/
.pytest_cache/

# --- Logs e arquivos temporarios ----------------------------------------
logs/
*.log
outputs/temp/
output/temp/
temp/
tmp/
*.tmp
*.swp
*.swo
*~

# --- Segredos / chaves (nunca versionar) --------------------------------
.env
.env.*
*.key
*.pem
secrets.yaml
secrets.yml
*_ncbi_api_key*
.config_ncbi

# --- Editores / IDE -----------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# --- Apresentações / slides ---------------------------------------------
*.pptx
*.key
*.odp
